{
  "name": "weavespace",
  "private": true,
  "version": "0.0.0-p0",
  "type": "module",
  "description": "WeaveSpace P0 technical probe workspace (no functional release)",
  "scripts": {
    "test:p0": "node tests/run-all.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "python tools/check_package.py",
    "dev:shell": "npm --prefix apps/shell run dev",
    "build:shell": "npm --prefix apps/shell run build",
    "start:server": "npm --prefix apps/server run start",
    "typecheck:apps": "npm --prefix apps/shell run typecheck && npm --prefix apps/server run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
