{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weavespace/schemas/plugin-manifest.v0.1.json",
  "title": "WeaveSpace Plugin Manifest (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "apiVersion",
    "fileExtensions",
    "provides",
    "requires",
    "requestedPermissions",
    "activationEvents",
    "entrypoints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,100}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1
    },
    "fileExtensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[A-Za-z0-9_-]{1,16}$"
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "requestedPermissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.read",
          "workspace.write",
          "network.request",
          "ai.invoke",
          "workspace.ui"
        ]
      }
    },
    "activationEvents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "client": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
