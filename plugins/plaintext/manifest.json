{
  "id": "weavespace.plaintext",
  "version": "0.1.0",
  "apiVersion": "0.1",
  "fileExtensions": [".md", ".markdown", ".txt"],
  "provides": ["file.viewer"],
  "requires": ["weavespace.document"],
  "requestedPermissions": ["workspace.read", "workspace.ui"],
  "activationEvents": ["onFileExtension:.txt", "onFileExtension:.md"],
  "entrypoints": {
    "client": "./client.tsx"
  }
}
